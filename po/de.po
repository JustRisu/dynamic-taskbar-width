msgctxt "Config"
msgid "Dynamic taskbar width enabled"
msgstr "Dynamische Taskleistenbreite aktiv"

msgctxt "Config"
msgid "Resting length (px)"
msgstr "Ruhelänge (px)"

msgctxt "Config"
msgid "Length the panel returns to. -1 keeps the script passive, so it never widens a panel without a known way back. tools/install.sh measures and fills this in on the first install."
msgstr "Länge, auf die das Panel zurückspringt. -1 lässt das Skript passiv, damit es nie ein Panel verbreitert, ohne einen bekannten Rückweg. tools/install.sh misst den Wert und trägt ihn bei der ersten Installation ein."

msgctxt "Config"
msgid "Panel index"
msgstr "Panel-Index"

msgctxt "Config"
msgid "Position of the panel in the plasma panel list. With a single panel, 0 is correct."
msgstr "Position des Panels in der Plasma-Panel-Liste. Bei einem einzigen Panel ist 0 richtig."

msgctxt "Config"
msgid "Only count windows on the panel's screen"
msgstr "Nur Fenster auf dem Bildschirm des Panels zählen"

msgctxt "Config"
msgid "Only count windows on the current desktop"
msgstr "Nur Fenster auf dem aktuellen Desktop zählen"

msgctxt "Config"
msgid "Also expand for fullscreen windows"
msgstr "Auch bei Vollbild-Fenstern verbreitern"
